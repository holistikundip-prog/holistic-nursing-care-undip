{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document storing patient or nakes profile details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID (auth uid)" },
        "name": { "type": "string", "description": "Full name of the user", "maxLength": 100 },
        "patientNumber": { "type": "string", "description": "Medical record number (Nomor Rekam Medis)", "maxLength": 50 },
        "phone": { "type": "string", "description": "Phone or WhatsApp number", "maxLength": 30 },
        "email": { "type": "string", "description": "Registered email address", "maxLength": 100 },
        "address": { "type": "string", "description": "Address of the patient", "maxLength": 300 },
        "emergencyContact": { "type": "string", "description": "Emergency contact name and phone", "maxLength": 100 },
        "medicalNotes": { "type": "string", "description": "Medical notes or allergies", "maxLength": 1000 },
        "joinedDate": { "type": "string", "description": "ISO date string when user joined", "maxLength": 30 },
        "isGuest": { "type": "boolean", "description": "Whether this is a temporary guest profile" },
        "role": { "type": "string", "description": "Role of the user (patient, nakes, admin)", "maxLength": 20 }
      },
      "required": ["id", "name", "email"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Holistic therapy appointment booked by a patient",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique appointment identifier", "maxLength": 100 },
        "bookingCode": { "type": "string", "description": "Booking confirmation code (e.g. HNC-2026-1234)", "maxLength": 50 },
        "userId": { "type": "string", "description": "UID of the patient who booked", "maxLength": 128 },
        "userName": { "type": "string", "description": "Name of the patient", "maxLength": 100 },
        "userPhone": { "type": "string", "description": "Phone number of the patient", "maxLength": 30 },
        "userEmail": { "type": "string", "description": "Email address of the patient", "maxLength": 100 },
        "patientNumber": { "type": "string", "description": "Patient medical record number", "maxLength": 50 },
        "therapyId": { "type": "string", "description": "ID of the selected therapy", "maxLength": 100 },
        "therapyName": { "type": "string", "description": "Name of the selected therapy", "maxLength": 150 },
        "locationId": { "type": "string", "description": "ID of the clinic location", "maxLength": 100 },
        "locationName": { "type": "string", "description": "Name of the clinic location", "maxLength": 200 },
        "date": { "type": "string", "description": "Booking date in YYYY-MM-DD format", "maxLength": 20 },
        "dayName": { "type": "string", "description": "Day name in Indonesian (Senin, Selasa, etc.)", "maxLength": 20 },
        "timeSlot": { "type": "string", "description": "Time slot (e.g. 09:00, 14:00)", "maxLength": 20 },
        "notes": { "type": "string", "description": "Special patient notes or complaints", "maxLength": 1000 },
        "status": { "type": "string", "description": "Current status of the appointment", "enum": ["Menunggu", "Terjadwal", "Selesai", "Dibatalkan"] },
        "createdAt": { "type": "string", "description": "Creation timestamp", "maxLength": 40 },
        "cancelledReason": { "type": "string", "description": "Reason if appointment was cancelled", "maxLength": 500 }
      },
      "required": ["id", "bookingCode", "userId", "userName", "therapyId", "date", "status"]
    },
    "ClinicalProgressNote": {
      "title": "ClinicalProgressNote",
      "description": "Medical & clinical progress notes entered by healthcare workers (Nakes)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique note ID", "maxLength": 100 },
        "patientId": { "type": "string", "description": "Patient user ID", "maxLength": 128 },
        "patientName": { "type": "string", "description": "Patient full name", "maxLength": 100 },
        "patientNumber": { "type": "string", "description": "Patient medical record number", "maxLength": 50 },
        "patientPhone": { "type": "string", "description": "Patient phone number", "maxLength": 30 },
        "patientEmail": { "type": "string", "description": "Patient email", "maxLength": 100 },
        "appointmentId": { "type": "string", "description": "Associated appointment ID", "maxLength": 100 },
        "bookingCode": { "type": "string", "description": "Associated booking code", "maxLength": 50 },
        "therapyName": { "type": "string", "description": "Therapy intervention administered", "maxLength": 150 },
        "visitDate": { "type": "string", "description": "Date of treatment/visit YYYY-MM-DD", "maxLength": 20 },
        "chiefComplaint": { "type": "string", "description": "Chief complaint / Keluhan utama", "maxLength": 1000 },
        "assessment": { "type": "string", "description": "Clinical assessment / Hasil pengkajian", "maxLength": 2000 },
        "intervention": { "type": "string", "description": "Administered nursing intervention", "maxLength": 2000 },
        "progressFollowUp": { "type": "string", "description": "Progress notes and follow-up plan", "maxLength": 2000 },
        "nurseName": { "type": "string", "description": "Name of the nurse / healthcare practitioner", "maxLength": 100 },
        "createdAt": { "type": "string", "description": "Creation timestamp", "maxLength": 40 }
      },
      "required": ["id", "patientId", "patientName", "patientNumber", "therapyName", "visitDate", "chiefComplaint", "assessment", "nurseName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document storing patient or staff information"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Appointment document for holistic nursing sessions"
    },
    "/clinical_progress_notes/{noteId}": {
      "schema": "ClinicalProgressNote",
      "description": "Clinical progress record created by nurses"
    }
  }
}
